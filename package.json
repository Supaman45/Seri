{
  "name": "reelforge",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @reelforge/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @reelforge/web db:generate",
    "db:migrate": "pnpm --filter @reelforge/web db:migrate",
    "db:seed": "pnpm --filter @reelforge/web db:seed"
  },
  "engines": {
    "node": ">=20.11"
  }
}
